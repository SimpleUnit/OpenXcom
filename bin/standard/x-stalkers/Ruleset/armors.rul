      - 1.0 #CHEMICAL (acid)
      - 6.0 #SMOKE
      - 1.0 #IMPACT (DT_10, blunt)
      - 1.0 #RADIATION (DT_11)
    loftempsSet: [ 2 ]
    deathFrames: 4
    units:
      - STR_SOLDIER
    allowsRunning: true
    allowsStrafing: true
    allowsKneeling: true
    instantWoundRecovery: true
    recovery: &defaultStaminaRecovery
      energy:
        stamina: 0.33
    kneelDownCost: 3
    kneelUpCost: 3
    tags:
      HEADSHOT_ODDS: 16
      SNEAK_RANGE_BRIGHT: 160
      SNEAK_RANGE_DARK: 96

  - type: STR_TIMELIMITER_UC
