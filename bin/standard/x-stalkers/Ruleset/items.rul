items:
  - &STR_KARABIN #---------------------------------------------------------------------------------------------------------------------------------------------------
    battleType: 1
    size: 0.2
    costBuy: 0  #If set to 0, this item will not be available in the Purchase/Recruit screen.
    costSell: 0
    monthlyMaintenance: 1000
    customItemPreviewIndex: 2
    bigSprite: 1
    floorSprite: 1
    handSprite: 0
    fireSound: 4
    meleeSound: 39
    meleeHitSound: 72
    meleeAnimation: 8
    meleeAnimFrames: 4
    meleeMissAnimation: 4
    meleeMissAnimFrames: 4
    meleePower: 1 #tylko dla bicia ludzi kolbą karabina
    meleeType: 10 #BLUNT
    meleeAlter: &bluntAlter
      IgnoreDirection: false
      IgnoreSelfDestruct: false
      ArmorEffectiveness: 0.0
      ToArmor: 0.0
      ToHealth: 0.25
      ToStun: 1.0
      RandomStun: false
      ToWound: 0.0
      ToEnergy: 0.2
      ToTile: 0.0
    meleeBonus: &bluntBonus
      strength: 0.2
      #flatHundred: 0.1
    accuracyAimed: 100
    accuracySnap: 80
    accuracyAuto: 50
    accuracyMelee: 100
    accuracyCloseQuarters: 50
    twoHanded: true
    meleeMultiplier:
      melee: 1.0
    closeQuartersMultiplier:
      flatHundred: 1.0
    aimRange: 20
    snapRange: 15
    autoRange: 7
    dropoff: 3
    powerRangeThreshold: 20
    powerRangeReduction: 1
    compatibleAmmo:
       - STR_MAGAYZNEK
    tuLoad: 15
    tuUnload: 8
    tuAimed: 40
    tuSnap: 22
    tuAuto: 35
    costMelee: &bluntCost
      time: 8
      energy: 4
    flatMelee: &bluntCostFlat
      time: true
      energy: true
    recoveryPoints: 1
    weight: 16
    invWidth: 1
    invHeight: 3
    armor: 60
    attraction: 20
    ai:
      meleeHitCount: 1
    supportedInventorySections: &NOTHEAD
      - STR_LEFT_HAND
      - STR_RIGHT_HAND
      - STR_BACK_PACK
      - STR_BELT

  - &STR_KARABINLONG
    refNode: *STR_KARABIN
