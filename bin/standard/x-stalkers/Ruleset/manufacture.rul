  - &ALL+
    ignore: true
    category: STR_ATTACHMENTS
    requiresBaseFunc: [STR_MAINBASE]
    time: 1
    refund: true

  - &ALL-
    ignore: true
    refNode: *ALL+
    category: STR_DETACHMENTS

  - &USP+
    name: STR_USP_S
    refNode: *ALL+
    requires: [STR_USP_UC]
    requiredItems:
      STR_USP: 1
      STR_SILENCER_USP: 1
    producedItems:
      STR_USP_S: 1

  - &USP-
    name: STR_USP_S-
    refNode: *ALL-
