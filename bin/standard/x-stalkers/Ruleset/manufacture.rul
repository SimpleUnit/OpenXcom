manufacture:
  - name: STR_MAKE_MOLOTOVS
    category: STR_MUNITIONS
    requiresBaseFunc:
      - STR_MAINBASE
    time: 1
    refund: true
    requiredItems:
      STR_FUEL_CANISTER: 1
    producedItems:
      STR_MOLOTOV: 5

  - name: STR_COMBINE_MOLOTOVS
    category: STR_MUNITIONS
    requiresBaseFunc:
      - STR_MAINBASE
    time: 1
    refund: true
    requiredItems:
      STR_MOLOTOV: 5
    producedItems:
      STR_FUEL_CANISTER: 1

  - &REPAIR_OUTFIT
    ignore: true
    category: STR_REPAIRS
    requiresBaseFunc:
      - STR_MAINBASE
    time: 50
    cost: 1000
    refund: true

  - name: STR_REPAIR_CHEAP_KEVLAR
    refNode: *REPAIR_OUTFIT
    requires:
      - STR_DAMAGED_CHEAP_KEVLAR
      - STR_SEWING_KIT
    time: 40
    requiredItems:
      STR_DAMAGED_CHEAP_KEVLAR: 2
    producedItems:
      STR_CHEAP_KEVLAR: 1

  - name: STR_REPAIR_SUNRISE
    refNode: *REPAIR_OUTFIT
    requires:
      - STR_SUNRISE_UC
      - STR_SEWING_KIT
    requiredItems:
      STR_DAMAGED_SUNRISE: 2
    producedItems:
      STR_SUNRISE: 1

  - name: STR_REPAIR_HEAVYSUNRISE
    refNode: *REPAIR_OUTFIT
    requires:
      - STR_HEAVYSUNRISE_UC
      - STR_SEWING_KIT
    requiredItems:
      STR_DAMAGED_HEAVYSUNRISE: 2
    producedItems:
      STR_HEAVYSUNRISE: 1

  - name: STR_REPAIR_COBRA
    refNode: *REPAIR_OUTFIT
    requires:
      - STR_COBRA_UC
      - STR_SEWING_KIT
    requiredItems:
      STR_DAMAGED_COBRA: 2
    producedItems:
      STR_COBRA: 1

  - name: STR_REPAIR_BERYL
    refNode: *REPAIR_OUTFIT
    requires:
      - STR_BERYL_UC
      - STR_SEWING_KIT
    requiredItems:
      STR_DAMAGED_BERYL: 2
    producedItems:
      STR_BERYL: 1

  - name: STR_REPAIR_EXO
    refNode: *REPAIR_OUTFIT
    requires:
      - STR_EXO_UC
    time: 100
    cost: 10000
    requiredItems:
      STR_DAMAGED_EXO: 2
    producedItems:
      STR_EXO: 1

  - &STEAL_OUTFIT
    ignore: true
    category: STR_OTHER_STALKERS
    requiresBaseFunc:
      - STR_MAINBASE
    time: 3
    refund: true

  - name: STR_STEAL_CHEAP_KEVLAR
    refNode: *STEAL_OUTFIT
    requires:
      - STR_BANDIT_JACKET_KEVLAR
    requiredItems:
      STR_BANDIT_JACKET_KEVLAR: 1
    producedItems:
      STR_CHEAP_KEVLAR: 1

  - name: STR_STEAL_BANDIT_COBRA
    refNode: *STEAL_OUTFIT
    requires:
      - STR_BANDIT_HEAVY
    requiredItems:
      STR_BANDIT_HEAVY: 1
    producedItems:
      STR_DAMAGED_COBRA: 1

  - name: STR_STEAL_STALKER_SUNRISE
    refNode: *STEAL_OUTFIT
    requires:
      - STR_STALKER_EXPERIENCED
    requiredItems:
      STR_STALKER_EXPERIENCED: 1
    producedItems:
      STR_SUNRISE: 1

  - name: STR_STEAL_STALKER_HEAVYSUNRISE
    refNode: *STEAL_OUTFIT
    requires:
      - STR_HEAVYSTALKER_EXPERIENCED
    requiredItems:
      STR_HEAVYSTALKER_EXPERIENCED: 1
    producedItems:
      STR_HEAVYSUNRISE: 1

  - name: STR_STEAL_MONOLIT_BERYL
    refNode: *STEAL_OUTFIT
    requires:
      - STR_HEAVYMONOLIT
    requiredItems:
      STR_HEAVYMONOLIT: 1
    producedItems:
      STR_BERYL: 1

  - name: STR_STEAL_MONOLIT_EXO
    refNode: *STEAL_OUTFIT
    requires:
      - STR_MONOLIT_EXO
    requiredItems:
      STR_MONOLIT_EXO: 1
    producedItems:
      STR_EXO: 1

  - name: STR_HIRE_STALKER
    category: STR_OTHER_STALKERS
    requiresBaseFunc:
      - STR_MAINBASE
    time: 1
    refund: true
    requiredItems:
      STR_GUEST_STALKER: 1
    producedItems: {}
    spawnedPersonType: STR_SOLDIER
  - name: STR_TAMED_BLINDDOG
    category: STR_MUTANTS_ANIMALS
    requires:
      - STR_BLINDDOG
    requiresBaseFunc:
      - STR_MAINBASE
    time: 144
    refund: true
    requiredItems:
      STR_BLINDDOG: 1
    producedItems: {}
    spawnedPersonType: STR_TAMED_BLINDDOG

