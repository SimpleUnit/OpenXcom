skills:
  - type: STR_SNEAK
    tags:
      SKILL_ID: 1
    costUse:
      time: 50
    flatUse:
      time: false
  - type: STR_MEASURE_DISTANCE
    tags:
      SKILL_ID: 2
    costUse:
      time: 1
    flatUse:
      time: true
    targetMode: 9
    compatibleWeapons:
      - STR_INV_NULL_DISTANCE
    checkHandsOnly: false
  - type: STR_AIM_HEAD
    tags:
      SKILL_ID: 3
    costUse:
      time: 1
    flatUse:
      time: true

extended:
  tags:
    RuleItem:
      ARTEFAKT_ID: int
      DRUNK_STAX_I: int
      PSI_PLUS_RAD: int
      ITEM_REACTIONS: int
      ITEM_CLOSEDCIRCUIT: int
      ITEM_NO_USING_IN_CLOSED_CIRCUIT: int
      ANIM_FRAMES_FLOOR: int
      ANOMALY_ID: int
      ANOMALY_VISIBILITY_DAY: int
      ANOMALY_VISIBILITY_NIGHT: int
      ANOMALY_SPOT_CHANCE_DAY: int
      ANOMALY_SPOT_CHANCE_NIGHT: int
      NOANIM: int
      ANOMALY_DETECT_CHANCE_HAND: int
      ANOMALY_DETECT_RANGE_HAND: int
      ANOMALY_DETECT_CHANCE_BELT: int
      ANOMALY_DETECT_RANGE_BELT: int
    RuleSkill:
      SKILL_ID: int
    BattleUnit:
      HIT_FLASH_FRAME: int
      HIT_FLASH_INTENSITY: int
      HIT_FLASH_COLOUR: int
      SKILL_SNEAK: int
      SNEAK_X: int
      SNEAK_Y: int
      U_RAND_STAMP: int
      U_RAND: int
      OG_TU: int
      OG_STA: int
      OG_HP: int
      OG_BRV: int
      OG_REA: int
      OG_ACC: int
      OG_THR: int
      OG_MEL: int
      OG_STR: int
      OG_PST: int
      TEMP_HP: int
      DRUNK_STAX: int
      HEADSHOOTING_MODE: int
      XP_REA: int
      XP_BRV: int
      RADIATION_OVERDOSE: int
      TU_DMG: int
      IS_CLOAKED: int
      ANOMALY_KILL: int
    BattleItem:
      I_RAND: int
      REVEAL: int
    RuleArmor:
      IS_ANOMALION: int
      SNEAK_RANGE_BRIGHT: int
      SNEAK_RANGE_DARK: int
      HEADSHOT_ODDS: int
      ANOMALY_VISION_BONUS_CHANCE: int
      ANOMALY_VISION_BONUS_RANGE: int
      CLOAKS: int
      DETECTS: int

  scripts:
    selectUnitSprite:
        #New indexes on unit spritesheet
        #Vanilla
          #264-266 - collapse
          #267-274 - female torso
        #Stalk mode
          #264-267 - collapse
          #268-271 - collapse ('female')
          #272-279 - alt left hand for shooting animation
          #280-287 - alt torso for shooting animation
          #288-295 - 'female' torso
          #296-303 - alt 'female' torso for shooting animation
      - offset: 10 #Adjust sprite offset to display 'female' torso from new location.
        code: |

          var int temp;
          var ptr RuleArmor zasadyArmora;

          if and neq blit_part blit_torso neq blit_part blit_collapse;
            return sprite_index;
          end;

          unit.getRuleArmor zasadyArmora;
          zasadyArmora.getForcedTorso temp;

          if eq temp TORSO_ALWAYS_MALE;
            return sprite_index;
          end;
          if eq temp TORSO_USE_GENDER;
            unit.getGender temp;
            if neq temp GENDER_FEMALE;
              return sprite_index;
            end;
          end;

          if eq blit_part blit_collapse;
            add sprite_index 4;
          else;
            if and ge sprite_index 267 le sprite_index 274;
              add sprite_index 21;
            end;
          end;

          return sprite_index;

      - offset: 11 #Firing animation for unit sprite.
        code: |

          var int temp;
          var ptr BattleItem item;
          var ptr RuleItem zasadyItema;

          unit.isAiming temp;
          if eq temp 0;
            return sprite_index;
          end;

          unit.getRightHandWeapon item;

          if eq item null;
            return sprite_index;
          end;

          item.getRuleItem zasadyItema;
          zasadyItema.getBattleType temp;
          if neq temp 1;
            return sprite_index;
          end;

          zasadyItema.isTwoHanded temp;
          if neq temp 1;
            return sprite_index;
          end;

          #torso v1
          if and ge sprite_index 32 le sprite_index 40;
            add sprite_index 248;
          end;

          #left hand
          if and ge sprite_index 240 le sprite_index 247;
            add sprite_index 32;
          end;

          #torso v2
          if and ge sprite_index 288 le sprite_index 295;
            add sprite_index 8;
          end;

          return sprite_index;

    recolorUnitSprite:
      - offset: 10 #Recolor unit gray to indicate that sneaking is active.
        code: |

          var int temp;
          var int tempTag;

          unit.getTurnsSinceSpotted temp;
          if le temp 1;
            return new_pixel;
          end;
          unit.getTag temp Tag.SKILL_SNEAK;
          if eq temp 0;
            return new_pixel;
          else eq temp 1;
            #Unit is flashing if sneak mode will expire without reactivating skill
            set temp anim_frame;
            mod temp 4;
            if gt temp 1;
              unit.getTag tempTag Tag.SNEAK_X;
              unit.getPosition.getX temp;
              if neq temp tempTag;
                return new_pixel;
              end;
              unit.getTag tempTag Tag.SNEAK_Y;
              unit.getPosition.getY temp;
              if neq temp tempTag;
                return new_pixel;
              end;
            end;
          end;
          set_color new_pixel 15;

          return new_pixel;

      - offset: 11 #Recolor unit yellow if headshooting mode is enabled, but watch out if sneaking is also active.
        code: |

          var int temp;

          unit.getTag temp Tag.HEADSHOOTING_MODE;
          if gt temp 0;
            unit.getTag temp Tag.SKILL_SNEAK;
            if gt temp 0;
              #Both sneaking and headshooting is active; make the colours alternate.
              set temp anim_frame;
              mod temp 4;
              if le temp 1;
                return new_pixel;
              end;
            end;

            set_color new_pixel 9;
          end;
          return new_pixel;

      - offset: 12 #Draw hit flash.
        code: |

          var int temp;
          var int frame; #3->2->1->(irrelevant)
          var int intensyw;

          #Prevent it from flashing whenever the battlescape loads
          if le anim_frame 3;
            return new_pixel;
          end;

          unit.getTag frame Tag.HIT_FLASH_FRAME;
          unit.getTag intensyw Tag.HIT_FLASH_INTENSITY;

          sub frame anim_frame;
          add frame 3;
          if gt frame 1;
            unit.getTag temp Tag.HIT_FLASH_COLOUR;
            set_color new_pixel temp;
          end;
          if gt frame 0;
            get_shade temp new_pixel;
            mul frame intensyw;
            sub temp frame;
            if lt temp intensyw;
              set_shade new_pixel intensyw;
            else gt temp 15;
              set_shade new_pixel 15;
            else;
              set_shade new_pixel temp;
            end;
          end;

          return new_pixel;

    selectItemSprite:
      - offset: 10 #Firing animation for item sprite.
        code: |

          var int temp;
          var ptr BattleUnit tempUnit;
          var ptr RuleItem zasadyItema;

          item.getOwner tempUnit;
          if eq tempUnit null;
            return sprite_index;
          end;

          tempUnit.isAiming temp;
          if eq temp 0;
            return sprite_index;
          end;

          item.getTag temp Tag.NOANIM;
          if neq temp 0;
            return sprite_index;
          end;

          item.getRuleItem zasadyItema;
          zasadyItema.getBattleType temp;
          if neq temp 1;
            return sprite_index;
          end;

          zasadyItema.isTwoHanded temp;
          if eq temp 1;
            if neq blit_part blit_item_righthand;
              return sprite_index;
            end;
          end;

          if and neq blit_part blit_item_righthand neq blit_part blit_item_lefthand;
            return sprite_index;
          end;

          add sprite_index 8;

          return sprite_index;

      - offset: 11 #Floorob item animation (notably for anomalies).
        code: |

          var int temp;
          var int numFrames;

          if neq blit_part blit_item_floor;
            return sprite_index;
          end;

          item.getTag numFrames Tag.ANIM_FRAMES_FLOOR;
          if le numFrames 1;
            return sprite_index;
          end;

          set temp anim_frame;
          div temp 2;
          mod temp numFrames;
          add sprite_index temp;

          return sprite_index;

    hitUnit:
      - offset: 10 #Headshots part1 - decide which part is being hit.
        code: |

          var int temp;
          var int randNum;
          var ptr RuleArmor zasadyArmora;

          #Enviro-effects don't headshot
          if eq attacker null;
            if eq part BODYPART_HEAD;
              set part BODYPART_TORSO;
            end;
            return power part side;
          end;

          #Only direct attacks benefit from headshot bonus (frag grenade qualifies because shrapnels)
          if and neq damaging_type 1 neq damaging_type 4 neq damaging_type 5 neq damaging_type 7;
            if eq part BODYPART_HEAD;
              set part BODYPART_TORSO;
            end;
            return power part side;
          else;
            attacker.getRuleArmor zasadyArmora;
            zasadyArmora.getTag temp Tag.HEADSHOT_ODDS;

            #No headshots in melee (bloodsucker being an exception)
            if eq battle_action battle_action_hit;
              if lt temp 100;
                set randNum 100;
              else;
                set randNum -100;
              end;
            else;
              battle_game.randomRange randNum 0 100;
              sub randNum temp;
              attacker.getTag temp Tag.HEADSHOOTING_MODE;
              if gt temp 0;
                sub randNum 60;
              end;
            end;

            if le randNum 0;
              set part BODYPART_HEAD;
            else eq battle_action battle_action_hit;
              #melee hits favour torso
              battle_game.randomRange temp 1 10;
              if gt temp 5;
                set part BODYPART_TORSO;
              end;
            else;
              set part BODYPART_TORSO;
            end;
          end;

          return power part side;

      - offset: 11 #Apply damage bonuses.
        code: |

          var int temp;
          var int tempDef;
          var int tempAtk;
          var int midPower;
          var int acc;
          var int dropoffRange;
          var int distance;
          var ptr RuleItem zasadyItema;
          var ptr RuleDamageType zasadyDmg;
          var ptr RuleArmor zasadyArmora;
          var ptr Tile tempTile1;
          var ptr Tile tempTile2;

          damaging_item.getRuleItem zasadyItema;
          if or eq zasadyItema null eq attacker null;
            #Skip enviro-effects.
            return power part side;
          end;

          #Calculate base power.
          zasadyItema.getBattleType temp;
          if and eq battle_action battle_action_hit neq temp BT_MELEE;
            zasadyItema.getMeleePowerWithBonus midPower attacker;
            zasadyItema.getMeleeDamageType zasadyDmg;
          else;
            zasadyItema.getPowerWithBonus midPower attacker;
            zasadyItema.getDamageType zasadyDmg;
          end;
          zasadyDmg.getResistType temp;
          unit.reduceByResistance midPower temp;

          #1 - Guaranteed 300% for a melee attack in sneak mode.
          if eq battle_action battle_action_hit;
            attacker.getTag temp Tag.SKILL_SNEAK;
            if neq temp 0;
              attacker.getTurnsSinceSpotted temp;
              if gt temp 1;
                set power midPower;
                mul power 3;
              end;
            end;
          else or eq battle_action battle_action_aimshoot eq battle_action battle_action_autoshoot eq battle_action battle_action_snapshot;
            #2 - Guaranteed high dmg roll when shooting from 1 tile away.
            set temp 0;

            #2a - No more than one tile away in X axis.
            unit.getPosition.getX tempAtk;
            attacker.getPosition.getX tempDef;
            sub tempAtk tempDef;
            abs tempAtk;
            if le tempAtk 1;
              add temp 1;
            end;

            #2b - No more than one tile away in Y axis.
            unit.getPosition.getY tempAtk;
            attacker.getPosition.getY tempDef;
            sub tempAtk tempDef;
            abs tempAtk;
            if le tempAtk 1;
              add temp 1;
            end;

            #2c - Award bonus.
            if eq temp 2;
              #Instead of rolling new 100%-150% value,
              # just flip it from 'below 100%' to 'above 100%' by the same delta.
              sub power midPower;
              abs power;
              add power midPower;
            end;

            #3 - Chance to convert a shot to max dmg roll when accuracy exceeds 100%.
            #      For that, we need to have calculated accuracy here in the script.
            #3a - Start from getting accuracy with bonuses.
            attacker.getFiringAccuracy acc weapon_item battle_action;
            #3b - Get dropoff range that matches this situation.
            weapon_item.getRuleItem zasadyItema;
            if eq battle_action battle_action_aimshoot;
              zasadyItema.getAimRange dropoffRange;
            else eq battle_action battle_action_snapshot;
              zasadyItema.getSnapRange dropoffRange;
            else eq battle_action battle_action_autoshoot;
              zasadyItema.getAutoRange dropoffRange;
            end;

            #3c - Calculate distance for dropoff.
            attacker.getPosition.getX temp;
            attacker.getPosition.getY tempAtk;
            attacker.getPosition.getZ tempDef;
            battle_game.getTile tempTile1 temp tempAtk tempDef;
            unit.getPosition.getX temp;
            unit.getPosition.getY tempAtk;
            unit.getPosition.getZ tempDef;
            battle_game.getTile tempTile2 temp tempAtk tempDef;
            tempTile1.getDistanceVoxel distance tempTile2;
            #equivalent of std::ceil(sqrt(float(distanceSq)))
            set temp distance;
            div distance 16;
            mod temp 16;
            if gt temp 0;
              add distance 1;
            end;

            #3d - Apply distance dropoff.
            set temp distance;
            sub temp dropoffRange;
            if gt temp 0;
              zasadyItema.getDropoff tempDef;
              mul temp tempDef;
              sub acc temp;
            end;

            #3e - Apply no LOS penalty (simplified, since not considering smoke).
            attacker.getRuleArmor zasadyArmora;
            unit.getTileShade temp;
            rules.getMaxDarknessToSeeUnits tempAtk;
            if gt temp tempAtk;
              zasadyArmora.getVisibilityAtDark temp;
              if eq temp 0;
                set temp 9;
              end;
            else;
              zasadyArmora.getVisibilityAtDay temp;
              if eq temp 0;
                set temp 20;
              end;
            end;
            if gt distance temp;
              zasadyItema.getNoLOSAccuracyPenalty temp;
              if lt temp 0;
                rules.getNoLOSAccuracyPenaltyGlobal temp;
              end;
              muldiv acc temp 100;
            end;

            #3f - Award max dmg roll.
            sub acc 100;
            if gt acc 0;
              battle_game.randomRange temp 0 100;
              if le temp acc;
                set power midPower;
                muldiv power 151 100;
              end;
            end;

            #4 - Apply power range reduction.
            zasadyItema.getPowerRangeThresholdRaw temp;
            if lt temp distance;
              sub temp distance;
              zasadyItema.getPowerRangeReductionRaw tempAtk;
              mul temp tempAtk;
              add power temp;
              if lt power 0;
                set power 0;
              end;
            end;
          end;

          #Set hit flash intensity.
          if eq midPower 0;
            set temp 0;
          else;
            set temp power;
            muldiv temp 100 midPower;
            sub temp 45; #Not 50,
            div temp 25;
            if gt temp 4;
              set temp 4;
            end;
            if lt temp 0;
              set temp 0;
            end;
          end;

          #To solve conflicting pellets of a shotgun, each trying to have a hit flash just for itself,
          # here we initialize tags for a new attack
          # and each upcomming operations on hit flash tags will overwrite values only with more impactful hits.
          battle_game.getAnimFrame tempAtk;
          unit.getTag tempDef Tag.HIT_FLASH_FRAME;
          if neq tempAtk tempDef;
            unit.setTag Tag.HIT_FLASH_COLOUR 0;
            unit.setTag Tag.HIT_FLASH_INTENSITY 0;
            unit.setTag Tag.HIT_FLASH_FRAME tempAtk;
          end;

          unit.getTag tempAtk Tag.HIT_FLASH_INTENSITY;
          if ge temp tempAtk;
            unit.setTag Tag.HIT_FLASH_INTENSITY temp;
          end;

          return power part side;

      - offset: 12 #Anomalies get revealed when discharging.
        code: |

          var int temp;
          var ptr RuleItem zasadyItema;

          damaging_item.getRuleItem zasadyItema;
          if eq zasadyItema null;
            return power part side;
          end;
          zasadyItema.getBattleType temp;
          if eq temp BT_ANOMALY;
            damaging_item.setTag Tag.REVEAL 1;
          end;

          return power part side;

    damageUnit:
      - offset: 10 #Armor bypass and more stun damage for headshots.
        code: |

          var int temp;
          var int tempPower;
          var ptre BattleItem tempItem;
          var ptr RuleInventory head_hopefully;
          var ptr RuleItem zasadyItema;
          var ptr RuleDamageType zasadyDmg;
          var text slot_id;

          if neq part BODYPART_HEAD;
            return;
          end;

          unit.getArmor temp side;

          #Un-substract armor values.
          unit.getArmor temp side;
          set tempPower currPower;
          add tempPower temp;

          #Instead, substract headgear's armor... if present.
          unit.getInventoryItem.size temp;
          loop var q temp;
            unit.getInventoryItem tempItem q;
            tempItem.getSlot head_hopefully;
            head_hopefully.getId slot_id;
            if eq slot_id "STR_HEAD";
              tempItem.getRuleItem zasadyItema;
              zasadyItema.getPower temp;
              sub tempPower temp;
            end;
          end;

          #Recalculate damages to health, stun, armor, etc. based on new attack power.
          damaging_item.getRuleItem zasadyItema;
          zasadyItema.getBattleType temp;
          if and eq battle_action battle_action_hit neq temp BT_MELEE;
            zasadyItema.getMeleeDamageType zasadyDmg;
          else;
            zasadyItema.getDamageType zasadyDmg;
          end;

          zasadyDmg.getDamageToHealth to_health tempPower;
          set to_armor 0;
          set to_stun tempPower;
          muldiv to_stun 25 100;
          zasadyDmg.getDamageToTime to_time tempPower;
          zasadyDmg.getDamageToEnergy to_energy tempPower;
          zasadyDmg.getDamageToMorale to_morale tempPower;
          if le to_health 0;
            set to_wound 0;
          end;
          zasadyDmg.getDamageToMana to_mana tempPower;

          battle_game.flashMessage "STR_HEADSHOT";

          return;

      - offset: 11 # Xenonaut armor dmg model - portion of damage that was stopped by armor will damage the armor (multiplied by ToArmor from ruleset)
        code: |

          var int currArmor;
          var ptr RuleItem zasadyItema;
          var ptr RuleDamageType zasadyDmg;

          #Hits in the head don't damage armor
          if eq part BODYPART_HEAD;
            return;
          end;

          damaging_item.getRuleItem zasadyItema;
          if eq zasadyItema null;
            #Skip enviro-effects.
            return;
          end;
          zasadyItema.getDamageType zasadyDmg;

          unit.getArmor currArmor side;
          if lt currPower 0;
            add currArmor currPower;
          end;

          zasadyDmg.getDamageToArmor to_armor currArmor;

          return;

      - offset: 12 #Bonus ELECTRIC damage from artifacts and/or prod.
        code: |

          var int temp;
          var int to_electric;
          var ptre BattleItem tempItem;
          var ptr RuleInventory belt_or_hand_hopefully;
          var text slot_id;

          if neq battle_action battle_action_hit;
            return;
          end;

          attacker.getInventoryItem.size temp;
          loop var q temp;
            attacker.getInventoryItem tempItem q;
            tempItem.getSlot belt_or_hand_hopefully;
            belt_or_hand_hopefully.getId slot_id;
            if eq slot_id "STR_BELT";
              tempItem.getTag temp Tag.ARTEFAKT_ID;
              #RAISIN
              if eq temp 10;
                add to_electric 8;
              end;
            else or eq slot_id "STR_LEFT_HAND" eq slot_id "STR_RIGHT_HAND";
              #prod goes here if implemented...?
            end;
          end;

          if lt to_electric 0;
            return;
          end;

          battle_game.randomRange temp 50 150;
          muldiv to_electric temp 100;
          unit.reduceByResistance to_electric 6;

          add to_stun to_electric;
          add to_time to_electric;

          return;

      - offset: 13 #Decide colour of hit flash.
        code: |

          #Colour priority:
          #1 Max dmg roll - gold(1)
          #2 Headshod - yellow(9)
          #3 Highest health dmg - red(2)
          #4 Highest stun dmg - blue(8)
          #5 Highest radiation damage - custom green(3)
          #6 No dmg - leave it white(0) or whatever was set by previous shotgun pellet.

          var int temp;
          var ptr RuleItem zasadyItema;

          unit.getTag temp Tag.HIT_FLASH_INTENSITY;

          if ge temp 4;
            unit.setTag Tag.HIT_FLASH_COLOUR 1; #CRIT HIT - gold
            return;
          end;

          unit.getTag temp Tag.HIT_FLASH_COLOUR;
          if neq temp 1;
            if eq part BODYPART_HEAD;
              set temp 9; #headshot - yellow
            else and le to_health 0 le to_stun 0 le to_mana 0;
              return;
            else ge to_health to_stun;
              if ge to_health to_mana;
                set temp 2; #Conventional - red
              else eq temp 0;
                set temp 3; #RADIATION - custom green
              end;
            else eq temp 0;
              if ge to_mana to_stun;
                set temp 3; #also radiation
              else;
                set temp 8; #into stun - blue
              end;
            end;
          end;

          unit.setTag Tag.HIT_FLASH_COLOUR temp;

          return;

      - offset: 14 #RUPTURE type deals +1 bleed.
        code: |

          var int temp;

          unit.isWoundable temp;
          if eq temp 0;
            return;
          end;

          if neq damaging_type 7;
            return;
          end;
          if le to_health 0;
            return;
          end;
          unit.addFatalwounds part 1;

          return;

      - offset: 15 #Morale dmg reduced by PST or BRV (depending on source) and grants bravery XP.
        code: |

          var int temp;

          if le to_morale 0;
            return;
          end;

          if eq damaging_item null;
            #Enviro-effect; represents psionic emission; reduce by PST
            unit.Stats.getPsiStrength temp;
            mul temp -1;
            add temp 100;
            muldiv to_morale temp 100;
          else;
            #A weapon that deals morale dmg; reduce by BRV
            unit.Stats.getBravery temp;
            mul temp -1;
            add temp 200;
            muldiv to_morale temp 200;
          end;

          unit.getTag temp Tag.XP_BRV;
          add temp to_morale;
          unit.setTag Tag.XP_BRV temp;

          return;

      - offset: 16 #TU damage carries over to next turn.
        code: |

          var int temp;
          var int unitTUs;

          if le to_time 0;
            return;
          end;

          set temp to_time;
          unit.getTimeUnits unitTUs;
          sub temp unitTUs;

          if le temp 0;
            return;
          end;

          unit.getTag unitTUs Tag.TU_DMG; 
          add unitTUs temp;
          unit.setTag Tag.TU_DMG unitTUs;

          return;

      - offset: 17 #Dmg reduction on easier difficulties.
        code: |

          var int temp;
          var int factor;

          unit.getFaction temp;
          if neq temp 0;
            return;
          end;

          battle_game.difficultyLevel temp;
          if eq temp DIFF_SUPERHUMAN;
            return;
          end;
          if eq temp DIFF_GENIUS;
            set factor 90;
          end;
          if eq temp DIFF_VETERAN;
            set factor 80;
          end;
          if eq temp DIFF_EXPERIENCED;
            set factor 70;
          end;
          if eq temp DIFF_BEGINNER;
            set factor 60;
          end;

          if gt to_health 0;
            muldiv to_health factor 100;
          end;
          if gt to_stun 0;
            muldiv to_stun factor 100;
          end;

          return;

      - offset: 18 #EnviroEffect that deals both RAD and morale dmg, here reduce RAD by resistance.
        code: |

          var int temp;

          if eq to_mana 314;
            set to_mana 5;
            unit.reduceByResistance to_mana 11;
            return;
          end;

          return;

      - offset: 19 #Damage reduction from worn artifacts & equipment.
        code: |

          var int temp;
          var int item_tag;
          var ptre BattleItem tempItem;
          var ptr RuleInventory belt_hopefully;
          var text slot_id;

          unit.getInventoryItem.size temp;
          loop var q temp;
            unit.getInventoryItem tempItem q;
            tempItem.getSlot belt_hopefully;
            belt_hopefully.getId slot_id;
            if eq slot_id "STR_BELT";
              tempItem.getTag item_tag Tag.ARTEFAKT_ID;
              #KOTLET
              if eq item_tag 1;
                muldiv to_mana 90 100;
              #BEAD
              else eq item_tag 2;
                #explosive, impact and stun reduction
                if eq damaging_type 3;
                  muldiv to_health 80 100;
                  muldiv to_armor 80 100;
                  muldiv to_stun 80 100;
                else eq damaging_type 10;
                  muldiv to_health 80 100;
                  muldiv to_energy 80 100;
                  muldiv to_stun 80 100;
                end;
                muldiv to_stun 80 100;
                muldiv to_time 80 100;
              #SPIRAL
              else eq item_tag 3;
                #ballistic reduction
                if eq damaging_type 1;
                  muldiv to_health 90 100;
                  muldiv to_armor 90 100;
                  muldiv to_stun 90 100;
                end;
              #TULLIP
              else eq item_tag 4;
                #rupture + less bleeding
                if eq damaging_type 7;
                  muldiv to_health 90 100;
                  muldiv to_armor 90 100;
                  muldiv to_stun 90 100;
                  muldiv to_wound 50 100;
                end;
              #PASTA
              else eq item_tag 5;
                #rad reduction large
                muldiv to_mana 75 100;
              #HEART
              else eq item_tag 6;
                #dmg reduction by flat value
                sub to_health 4;
                if le to_health 0;
                  set to_health 0;
                end;
              #SHARD
              else eq item_tag 7;
                #acid reduction
                if eq damaging_type 8;
                  muldiv to_health 75 100;
                  muldiv to_armor 75 100;
                  muldiv to_stun 75 100;
                  muldiv to_wound 75 100;
                end;
              #DROPLET
              else eq item_tag 13;
                #fire reduction
                if eq damaging_type 2;
                  muldiv to_health 75 100;
                  muldiv to_stun 75 100;
                end;
              end;
            end;
          end;

          return;

      - offset: 20 #Radiation poisoning
        code: |

          var int temp;

          # unless unit has no concept of radiation
          unit.Stats.getManaPool temp;
          if eq temp 0;
            return;
          end;

          unit.getMana temp;
          if le temp 0;
            unit.setTag Tag.RADIATION_OVERDOSE 1;
          end;

          return;

      - offset: 21 #If hit by anomaly, memorize it to correctly log death cause in soldier diary later.
        code: |

          var int temp;

          damaging_item.getTag temp Tag.ANOMALY_ID;
          if gt temp 0;
            unit.setTag Tag.ANOMALY_KILL temp;
          end;

          return;

    healUnit:
      - offset: 10 #Prevent using medical items if closed circuit outfit (or headgear) forbids it.
        code: |

          var int temp;
          var int condition;
          var ptre BattleItem tempItem;
          var ptr RuleInventory head_hopefully;
          var text slot_id;

          item.getTag temp Tag.ITEM_NO_USING_IN_CLOSED_CIRCUIT;
          if le temp 0;
            return;
          end;

          target.getInventoryItem.size temp;
          loop var q temp;
            target.getInventoryItem tempItem q;
            tempItem.getSlot head_hopefully;
            head_hopefully.getId slot_id;
            if eq slot_id "STR_HEAD";
              tempItem.getTag temp Tag.ITEM_CLOSEDCIRCUIT;
              if gt temp 0;
                set condition 1;
              end;
            end;
          end;

          if le condition 0;
            return;
          end;

          #Revert item's effects and refund use costs.
          item.getTag temp Tag.DRUNK_STAX_I;
          if gt temp 0;
            #Values same as use cost from item's ruleset.
            actor.addMorale -10;
            actor.addStun -5;
          end;

          item.getActionCost.getTimeUnits temp actor battle_action_use;
          actor.addTimeUnits temp;

          if eq medikit_action_type medikit_action_heal;
            item.getHealQuantity temp;
            add temp 1;
            item.setHealQuantity temp;
          else eq medikit_action_type medikit_action_stimulant;
            item.getStimulantQuantity temp;
            add temp 1;
            item.setStimulantQuantity temp;
          else eq medikit_action_type medikit_action_painkiller;
            item.getPainKillerQuantity temp;
            add temp 1;
            item.setStimulantQuantity temp;
          end;

          set wound_recovery 0;
          set health_recovery 0;
          set energy_recovery 0;
          set stun_recovery 0;
          set mana_recovery 0;
          set morale_recovery 0;
          set painkiller_recovery 0;

          battle_game.flashMessage "STR_NO_USING_CLOSED_CIRCUIT";

          return;

      - offset: 11 #Medkits restore health even with no fatal wounds present.
        code: |

          var int temp;

          if neq medikit_action_type medikit_action_heal;
            return;
          end;
          target.getFatalwounds temp body_part;
          add temp 1;
          target.setFatalwounds body_part temp;
          add wound_recovery 1;

          return;

      - offset: 12 #Apply drunk stacks (will obey closed circuit restriction).
        code: |

          var int temp;
          var int stax;

          if eq mana_recovery 0;
            return;
          end;

          item.getTag temp Tag.DRUNK_STAX_I;
          target.getTag stax Tag.DRUNK_STAX;
          add stax temp;
          target.setTag Tag.DRUNK_STAX stax;

          return;

    createUnit:
      - offset: 10 #Init stat tags for reverting artifact bonuses.
        code: |

          var int temp;

          unit.Stats.getTimeUnits temp;
          unit.setTag Tag.OG_TU temp;
          unit.Stats.getStamina temp;
          unit.setTag Tag.OG_STA temp;
          unit.Stats.getHealth temp;
          unit.setTag Tag.OG_HP temp;
          unit.Stats.getBravery temp;
          unit.setTag Tag.OG_BRV temp;
          unit.Stats.getReactions temp;
          unit.setTag Tag.OG_REA temp;
          unit.Stats.getFiring temp;
          unit.setTag Tag.OG_ACC temp;
          unit.Stats.getThrowing temp;
          unit.setTag Tag.OG_THR temp;
          unit.Stats.getMelee temp;
          unit.setTag Tag.OG_MEL temp;
          unit.Stats.getStrength temp;
          unit.setTag Tag.OG_STR temp;
          unit.Stats.getPsiStrength temp;
          unit.setTag Tag.OG_PST temp;

          return;

      - offset: 11 #Enemies start with 0 TUs.
        code: |

          var int faction;

          unit.getFaction faction;
          if neq faction 1;
            return;
          end;

          unit.setTimeUnits 0;

          return;

    newTurnUnit:
      - offset: 10
        code: |

          unit.setTag Tag.HEADSHOOTING_MODE 0;
          unit.setTag Tag.U_RAND_STAMP 0;
          unit.setTag Tag.U_RAND 0;

          return;

      - offset: 11 #Apply drunk debuff / reset stats to default.
        code: |

          var int temp;
          var int stax;
          var int capped_stax;

          if eq side 2;
            return;
          end;

          unit.getTag stax Tag.DRUNK_STAX;

          set capped_stax stax;
          if lt capped_stax -5;
            set capped_stax -5;
          end;
          if gt capped_stax 15;
            set capped_stax 15;
          end;

          #deal stun damage
          if eq side 0;
            set temp capped_stax;
            muldiv temp 66 100;
            unit.addStun temp;

            if gt stax 0;
              sub stax 1;
            end;
            if lt stax 0;
              add stax 1;
            end;
            unit.setTag Tag.DRUNK_STAX stax;
          end;

          unit.getTag temp Tag.OG_BRV;
          if gt capped_stax 0;
            set stax capped_stax;
            mul stax 5;
            add temp stax;
          end;
          unit.Stats.setBravery temp;

          mul capped_stax -5;
          add capped_stax 100;

          unit.getTag temp Tag.OG_ACC;
          muldiv temp capped_stax 100;
          unit.Stats.setFiring temp;
          unit.getTag temp Tag.OG_THR;
          muldiv temp capped_stax 100;
          unit.Stats.setThrowing temp;
          unit.getTag temp Tag.OG_MEL;
          muldiv temp capped_stax 100;
          unit.Stats.setMelee temp;
          unit.getTag temp Tag.OG_REA;
          muldiv temp capped_stax 100;
          unit.Stats.setReactions temp;

          #Don't do any operations on maxHP yet to avoid losing health due to rounding errors
          unit.getTag temp Tag.OG_HP;
          unit.setTag Tag.TEMP_HP temp;

          #just restore to original, no drunk staxx
          unit.getTag temp Tag.OG_TU;
          unit.Stats.setTimeUnits temp;
          unit.getTag temp Tag.OG_STA;
          unit.Stats.setStamina temp;
          unit.getTag temp Tag.OG_STR;
          unit.Stats.setStrength temp;
          unit.getTag temp Tag.OG_PST;
          unit.Stats.setPsiStrength temp;

          return;

      - offset: 12 #Xenonaut overburden penalty - max TUs is lowered too.
        code: |

          var int temp;

          unit.getFaction temp;
          if neq side temp;
            return;
          end;
          unit.getTimeUnits temp;
          unit.Stats.setTimeUnits temp;

          return;

      - offset: 13 #Apply TU damage accumulated on previous turn.
        code: |

          var int temp;
          var int unitTUs;
          
          unit.getFaction temp;
          if neq side temp;
            return;
          end;

          unit.getTag temp Tag.TU_DMG; 
          if gt temp 0;
            unit.getTimeUnits unitTUs;
            sub unitTUs temp;
            unit.setTimeUnits unitTUs;
            unit.setTag Tag.TU_DMG 0;
          end;

          return;

      - offset: 14 #End sneak mode when unit has moved without reactivating the skill.
        code: |

          var int prev_X;
          var int prev_Y;
          var int curr_X;
          var int curr_Y;
          var int skill_sneak;

          if eq side 2;
            return;
          end;

          unit.getTag prev_X Tag.SNEAK_X;
          unit.getTag prev_Y Tag.SNEAK_Y;
          unit.getPosition.getX curr_X;
          unit.getPosition.getY curr_Y;
          unit.getTag skill_sneak Tag.SKILL_SNEAK;

          if or neq prev_X curr_X neq prev_Y curr_Y;
            if gt skill_sneak 0;
              sub skill_sneak 1;
              unit.setTag Tag.SKILL_SNEAK skill_sneak;
            end;
          end;
          unit.setTag Tag.SNEAK_X curr_X;
          unit.setTag Tag.SNEAK_Y curr_Y;

          return;

      - offset: 15 #Grant stat bonuses & penalties from equipped artifacts or other gear.
        code: |

          var int temp;
          var int radiacja;
          var int item_tag;
          var int woundLoopMax;
          var int fireballs;
          var ptre BattleItem tempItem;
          var ptr RuleInventory belt_or_head_hopefully;
          var text slot_id;

          unit.getFaction temp;
          if neq side temp;
            return;
          end;

          unit.getInventoryItem.size temp;
          loop var q temp;
            unit.getInventoryItem tempItem q;
            tempItem.getSlot belt_or_head_hopefully;
            belt_or_head_hopefully.getId slot_id;
            if eq slot_id "STR_BELT";
              tempItem.getTag item_tag Tag.ARTEFAKT_ID;
              #KOTLET
              if eq item_tag 1;
                add radiacja 4;
              #BEAD
              else eq item_tag 2;
                add radiacja -5;
              #SPIRAL
              else eq item_tag 3;
                add radiacja -7;
              #TULLIP
              else eq item_tag 4;
                add radiacja -3;
              #PASTA
              else eq item_tag 5;
                add radiacja 6;
              #HEART
              else eq item_tag 6;
                add radiacja -7;
              #SHARD
              else eq item_tag 7;
                unit.addHealth 2;
                add radiacja -3;
              #EMERALD
              else eq item_tag 8;
                unit.Stats.addBravery 10;
                unit.Stats.addPsiStrength 10;
                add radiacja -5;
              #SNOT
              else eq item_tag 9;
                unit.Stats.addTimeUnits -4;
                add radiacja -7;
              #RAISIN
              else eq item_tag 10;
                add radiacja -3;
              #BATTERY
              else eq item_tag 11;
                unit.Stats.addTimeUnits 9;
                unit.addTimeUnits 9;
                unit.addStun -4;
                unit.addEnergy 8;
                add radiacja -5;
              #ATOM
              else eq item_tag 12;
                unit.Stats.addReactions 5;
                unit.Stats.addFiring 5;
                unit.Stats.addThrowing 5;
                unit.Stats.addMelee 5;
                unit.Stats.addTimeUnits 3;
                unit.addTimeUnits 3;
                add radiacja -7;
              #DROPLET
              else eq item_tag 13;
                add woundLoopMax 2;
                add radiacja -3;
              #FIREBALL
              else eq item_tag 14;
                add woundLoopMax 1;
                add fireballs 1;
                add radiacja -5;
              #MEDUZA
              else eq item_tag 15;
                unit.Stats.addStrength 10;
                unit.getTag temp Tag.TEMP_HP;
                add temp 10;
                unit.setTag Tag.TEMP_HP temp;
                add radiacja -7;
              end;
            else eq slot_id "STR_HEAD";
              tempItem.getTag item_tag Tag.ITEM_REACTIONS;
              if neq item_tag 0;
                unit.Stats.getReactions temp;
                add temp item_tag;
                unit.Stats.setReactions temp;
              end;
            end;
          end;

          #Fireball heals 4hp, or 1hp and 1 wound. Count how many fireballs qualify to give 4.
          unit.getFatalwoundsTotal temp;
          sub temp woundLoopMax;
          mul temp -1;
          limit temp 0 fireballs;
          mul temp 3;
          add fireballs temp;
          unit.addHealth fireballs;

          #Remove fatal wounds
          loop var q woundLoopMax;
            loop var p 6;
              unit.getFatalwounds temp p;
              if and gt temp 0 gt woundLoopMax 0;
                unit.addFatalwounds p -1;
                sub woundLoopMax 1;
              end;
            end;
          end;

          #Don't lower maxTUs too much in case of too many snots
          unit.Stats.getTimeUnits temp;
          if lt temp 24;
            set temp 24;
            unit.Stats.setTimeUnits 24;
          end;

          unit.Stats.getManaPool temp;
          if neq temp 0;
            unit.getMana temp;
            add temp radiacja;
            unit.setMana temp;
            if le temp 0;
              unit.setTag Tag.RADIATION_OVERDOSE 1;
            end;
          end;

          return;

      - offset: 16 #Change current HP if maxHP has changed.
        code: |

          var int temp;
          var int old_hp;
          var int new_hp;

          unit.Stats.getHealth old_hp;
          unit.getTag new_hp Tag.TEMP_HP;

          if eq old_hp new_hp;
            return;
          end;

          if gt new_hp old_hp;
            unit.getHealth temp;
            mul temp 100;
            muldiv temp new_hp old_hp;
            div temp 100;
            unit.setHealth temp;
          end;

          return;

      - offset: 17 #Bloodsuckers renew the cloak at the start of a turn.
        code: |

          var int temp;
          var ptr RuleArmor zasadyArmora;

          unit.getRuleArmor zasadyArmora;
          zasadyArmora.getTag temp Tag.CLOAKS;
          if gt temp 0;
            unit.setTag Tag.IS_CLOAKED temp;
          end;

          return;

    visibilityUnit:
      - offset: 10 #Spotting sneaking units.
        code: |

          var int temp;
          var int spottingDistance;
          var ptr RuleArmor zasadyArmora;

          target_unit.getTag temp Tag.SKILL_SNEAK;
          if eq temp 0;
            return current_visibility visibility_mode;
          end;

          target_unit.getTurnsSinceSpotted temp;
          if le temp 1;
            return current_visibility visibility_mode;
          end;

          target_unit.getRuleArmor zasadyArmora;
          target_unit.getTileShade temp;
          rules.getMaxDarknessToSeeUnits spottingDistance;
          if gt temp spottingDistance;
            zasadyArmora.getTag spottingDistance Tag.SNEAK_RANGE_DARK;
          else;
            zasadyArmora.getTag spottingDistance Tag.SNEAK_RANGE_BRIGHT;
          end;

          target_unit.isKneeled temp;
          if eq temp 1;
            sub spottingDistance 48;
          end;

          if or le spottingDistance 0 le distance spottingDistance;
            return current_visibility visibility_mode;
          end;

          set current_visibility 0;

          return current_visibility visibility_mode;

      - offset: 11 #Anomalions are invisible
        code: |

          var int temp;

          target_unit.getTag temp Tag.IS_ANOMALION;
          if ge temp 1;
            set current_visibility 0;
          end;

          return current_visibility visibility_mode;

      - offset: 12 #Spotting cloaked units.
        code: |

          var int temp;
          var int react;
          var int locationStamp;
          var int randNum;
          var int targetRandNum;
          var ptr RuleArmor zasadyArmora;

          target_unit.getTag temp Tag.IS_CLOAKED;
          if or le temp 0 le current_visibility 0;
            return current_visibility visibility_mode;
          end;
          observer_unit.getRuleArmor zasadyArmora;

          # trivial cases - detect unit from up close or if observer ignores cloaking
          zasadyArmora.getTag temp Tag.DETECTS;
          if or le distance 48 gt temp 0;
            target_unit.setTag Tag.IS_CLOAKED -1;
            return current_visibility visibility_mode;
          end;

          # The engine calls the handle many times even while standing still,
          # But I want random spotting chance.
          # So this is a workaround to prevent it from rolling more than once per location.
          observer_unit.getPosition.getX locationStamp;
          mul locationStamp 256;
          observer_unit.getPosition.getY temp;
          add locationStamp temp;
          mul locationStamp 256;
          observer_unit.getPosition.getZ temp;
          add locationStamp temp;
          mul locationStamp 8;
          observer_unit.getDirection temp;
          add locationStamp temp;

          observer_unit.getTag temp Tag.U_RAND_STAMP;
          if eq locationStamp temp;
            observer_unit.getTag randNum Tag.U_RAND;
          else;
            observer_unit.setTag Tag.U_RAND_STAMP locationStamp;
            #there's no access to battle_game to invoke randomRange, so try to come up with a random number differently.
            observer_unit.getTag randNum Tag.U_RAND;
            observer_unit.getPosition.getX temp;
            add randNum temp;
            observer_unit.getPosition.getY temp;
            add randNum temp;
            observer_unit.getPosition.getZ temp;
            add randNum temp;
            observer_unit.getId temp;
            add randNum temp;
            observer_unit.getReactionScore temp;
            add randNum temp;
            mod randNum 100;
            observer_unit.setTag Tag.U_RAND randNum;
          end;

          # Same for target
          target_unit.getPosition.getX locationStamp;
          mul locationStamp 256;
          target_unit.getPosition.getY temp;
          add locationStamp temp;
          mul locationStamp 256;
          target_unit.getPosition.getZ temp;
          add locationStamp temp;
          mul locationStamp 8;
          target_unit.getDirection temp;
          add locationStamp temp;

          target_unit.getTag temp Tag.U_RAND_STAMP;
          if eq locationStamp temp;
            target_unit.getTag targetRandNum Tag.U_RAND;
          else;
            target_unit.setTag Tag.U_RAND_STAMP locationStamp;
            #there's no access to battle_game to invoke randomRange, so try to come up with a random number differently.
            target_unit.getTag targetRandNum Tag.U_RAND;
            target_unit.getPosition.getX temp;
            add targetRandNum temp;
            target_unit.getPosition.getY temp;
            add targetRandNum temp;
            target_unit.getPosition.getZ temp;
            add targetRandNum temp;
            target_unit.getId temp;
            add targetRandNum temp;
            target_unit.getReactionScore temp;
            add targetRandNum temp;
            mod targetRandNum 100;
            target_unit.setTag Tag.U_RAND targetRandNum;
          end;

          add randNum targetRandNum;
          mod randNum 100;

          #Do the spotting roll
          set temp 50;
          observer_unit.Stats.getReactions react;
          muldiv temp react 100;
          if gt randNum temp;
            return -1 visibility_mode;
          else gt current_visibility 0;
            observer_unit.getTag temp Tag.XP_REA;
            add temp 1;
            observer_unit.setTag Tag.XP_REA temp;
            target_unit.setTag Tag.IS_CLOAKED -1;
          end;

          return current_visibility visibility_mode;

    visibilityAnomaly:
      - offset: 10 #Spotting the anomalies
        code: |

          var int temp;
          var int spotRange;
          var int spotChance;
          var int locationStamp;
          var int randNum;
          var ptre BattleItem tempItem;
          var ptr RuleArmor zasadyArmora;
          var ptr RuleInventory belt_or_hand_hopefully;
          var text slot_id;

          anomaly.getTag temp Tag.REVEAL;
          if neq temp 0;
            return current_visibility visibility_mode;
          end;

          # The engine calls the handle many times even while standing still,
          # But I want random spotting chance.
          # So this is a workaround to prevent it from rolling more than once per location.
          observer_unit.getPosition.getX locationStamp;
          mul locationStamp 256;
          observer_unit.getPosition.getY temp;
          add locationStamp temp;
          mul locationStamp 256;
          observer_unit.getPosition.getZ temp;
          add locationStamp temp;
          mul locationStamp 8;
          observer_unit.getDirection temp;
          add locationStamp temp;

          observer_unit.getTag temp Tag.U_RAND_STAMP;
          if eq locationStamp temp;
            observer_unit.getTag randNum Tag.U_RAND;
          else;
            observer_unit.setTag Tag.U_RAND_STAMP locationStamp;
            battle_game.randomRange randNum 0 100;
            observer_unit.setTag Tag.U_RAND randNum;
          end;

          anomaly.getTag temp Tag.I_RAND;
          add randNum temp;
          mod randNum 100;

          observer_unit.getRuleArmor zasadyArmora;
          zasadyArmora.getTag temp Tag.ANOMALY_VISION_BONUS_CHANCE;
          sub randNum temp;

          if eq is_dark 1;
            anomaly.getTag spotRange Tag.ANOMALY_VISIBILITY_NIGHT;
            anomaly.getTag spotChance Tag.ANOMALY_SPOT_CHANCE_NIGHT;
          else;
            anomaly.getTag spotRange Tag.ANOMALY_VISIBILITY_DAY;
            anomaly.getTag spotChance Tag.ANOMALY_SPOT_CHANCE_DAY;
          end;

          #First let the unit try to spot anything
          if eq spotRange 0;
            set spotRange distance_max;
          else;
            zasadyArmora.getTag temp Tag.ANOMALY_VISION_BONUS_RANGE;
            add spotRange temp;
            mul spotRange 16;
          end;
          if le distance spotRange;
            if neq spotChance 0;
              observer_unit.Stats.getReactions temp;
              muldiv spotChance temp 100;
              if gt randNum spotChance;
                #Roll failed. Move on to see if the detector spots it.
              else gt current_visibility 0;
                observer_unit.getTag temp Tag.XP_REA;
                add temp 1;
                observer_unit.setTag Tag.XP_REA temp;
                return current_visibility visibility_mode;
              end;
            else;
              return current_visibility visibility_mode;
            end;
          else;
            #Roll failed. Move on to see if the detector spots it.
          end;

          #Now let detectors try to detect something
          observer_unit.getInventoryItem.size temp;
          loop var q temp;
            observer_unit.getInventoryItem tempItem q;
            tempItem.getSlot belt_or_hand_hopefully;
            belt_or_hand_hopefully.getId slot_id;
            set spotChance 0;
            set spotRange 0;
            if eq slot_id "STR_BELT";
              tempItem.getTag spotChance Tag.ANOMALY_DETECT_CHANCE_BELT;
              tempItem.getTag spotRange Tag.ANOMALY_DETECT_RANGE_BELT;
              mul spotRange 16;
            else or eq slot_id "STR_RIGHT_HAND" eq slot_id "STR_LEFT_HAND";
              tempItem.getTag spotChance Tag.ANOMALY_DETECT_CHANCE_HAND;
              tempItem.getTag spotRange Tag.ANOMALY_DETECT_RANGE_HAND;
              mul spotRange 16;
            end;
            if and gt spotChance 0 gt spotRange 0;
              add randNum locationStamp;
              mod randNum 100;
              if and le distance spotRange le randNum spotChance;
                return current_visibility visibility_mode; 
              end;
            end;
          end;

          return -1 visibility_mode;

    skillUseUnit:
      - offset: 10
        code: |

          var int temp;
          var int skill_id;

          skill.getTag skill_id Tag.SKILL_ID;

          if eq skill_id 1;
            actor.getTurnsSinceSpotted temp;
            if le temp 1;
              battle_game.flashMessage "STR_CANNOT_SNEAK";
              return;
            end;
            actor.getTag temp Tag.SKILL_SNEAK;
            if eq temp 2;
              battle_game.flashMessage "STR_ALREADY_SNEAKING";
              return;
            end;
            if eq have_tu 1;
              set spend_tu 1;
              actor.setTag Tag.SKILL_SNEAK 2;
              battle_game.flashMessage "STR_SNEAKING_ENABLED";
            end;
          else eq skill_id 2;
            set continue_action 1;
            set spend_tu 0;
          else eq skill_id 3;
            actor.getTag temp Tag.HEADSHOOTING_MODE;
            if eq temp 0;
              actor.setTag Tag.HEADSHOOTING_MODE 1;
              battle_game.flashMessage "STR_HEADSHOOTING_ENABLED";
            else;
              actor.setTag Tag.HEADSHOOTING_MODE 0;
              battle_game.flashMessage "STR_HEADSHOOTING_DISABLED";
            end;
          end;

          return;

    statusBeforeReturnUnit:
      - offset: 10 #Adjust death cause in soldier diary if died to radiation poisoning, anomalies or other environmental hazards.
        code: |

          var int temp;
          var text tempText;

          murder_weapon.getText tempText;
          if and eq return_status return_status_kia eq tempText "STR_WEAPON_UNKNOWN";
            unit.getTag temp Tag.ANOMALY_KILL;
            if neq temp 0;
              if eq temp 1;
                set tempText "STR_ANOMALY_SPRINGBOARD";
              else eq temp 2;
                set tempText "STR_ANOMALY_VORTEX";
              else eq temp 3;
                set tempText "STR_ANOMALY_KVASS";
              else eq temp 4;
                set tempText "STR_ANOMALY_ELECTRO";
              else eq temp 5;
                set tempText "STR_ANOMALY_BURNER";
              end;
              murder_weapon.setText tempText;
              set tempText "STR_THE_ZONE";
              killer.setText tempText;
            end;
          end;

          unit.getTag temp Tag.RADIATION_OVERDOSE;
          if and eq temp 1 eq return_status return_status_ok;
            #Irradiated stalker dies post-mission.
            set return_status return_status_hidden_kia;
            set tempText "STR_THE_ZONE";
            killer.setText tempText;
            set tempText "STR_RADIATION_POISONING";
            murder_weapon.setText tempText;
          end;

          return return_status recover_armor;

      - offset: 11 #Award BRV and REA experience.
        code: |

          var int temp;
          
          unit.getTag temp Tag.XP_REA;
          if gt temp 0;
            div temp 10;
            add temp 1;
            unit.Exp.addReactions temp;
          end;

          unit.getTag temp Tag.XP_BRV;
          if gt temp 0;
            div temp 10;
            add temp 1;
            unit.Exp.addBravery temp;
          end;

          return return_status recover_armor;

    tryMeleeAttackItem:
      - offset: 10
        code: |

          var int temp;
          var int tempAtk;
          var int tempDef;

          if eq battle_action 16; #battle_action_cqb
            #get base chance (20, 50 or 80)
            set melee_attack_success attack_strength;

            #apply bonus 30 when from the side / back
            attacker.getDirection tempAtk;
            victim.getDirection tempDef;
            add tempAtk 8;
            add tempDef 8;
            sub tempAtk tempDef;
            if and ge tempAtk -2 le tempAtk 2;
              add melee_attack_success 30;
            end;

            #apply STR diff if attacker has more
            attacker.Stats.getStrength tempAtk;
            victim.Stats.getStrength tempDef;
            if gt tempAtk tempDef;
              add melee_attack_success tempAtk;
              sub melee_attack_success tempDef;
            end;

            #roll
            random.randomRange temp 0 99;
            sub melee_attack_success temp;
          else; #not cqc; use stock formula
            random.randomRange temp 0 99;
            sub melee_attack_success temp;
            add melee_attack_success attack_strength;
            sub melee_attack_success defense_strength;
            add melee_attack_success defense_strength_penalty;
          end;

          #Affect the odds by reaction difference between fighters.
          set temp melee_attack_success;
          attacker.Stats.getReactions tempAtk;
          add melee_attack_success tempAtk;
          add melee_attack_success tempAtk;
          victim.Stats.getReactions tempDef;
          sub melee_attack_success tempDef;
          sub melee_attack_success tempDef;

          #If reactions made a difference, award experience to winner.
          if and gt temp 0 le melee_attack_success 0;
            victim.getTag temp Tag.XP_REA;
            add temp 1;
            victim.setTag Tag.XP_REA temp;
          else and le temp 0 gt melee_attack_success 0;
            attacker.getTag temp Tag.XP_REA;
            add temp 1;
            attacker.setTag Tag.XP_REA temp;
          end;

          return melee_attack_success;

    newTurnItem:
      - offset: 10 # roll new seed for anomalies
        code:

          var int temp;
          var ptr RuleItem zasadyItema;

          item.getRuleItem zasadyItema;
          zasadyItema.getBattleType temp;
          if neq temp BT_ANOMALY;
            return;
          end;

          battle_game.randomRange temp 0 100;
          item.setTag Tag.I_RAND temp;
          item.setTag Tag.REVEAL 0;

          return;

    detectUfoFromCraft:
      - offset: 10 #Only spot anomaly sites when they are not moving.
        code: |

          var int temp;

          ufo.getStatus temp;
          if neq temp UFO_LANDED;
            ufo.Stats.getSpeedMax temp;
            if or eq temp 1000 eq temp 10000;
              set detection_chance 0;
            end;
          end;

          return detection_type detection_chance;

      - offset: 11 #Only spot ambush type encounters when they are locked on.
        code: |

          var int temp;

          ufo.getTag temp Tag.IS_AMBUSH;
          if gt temp 0;
            return 0 0;
          end;

          return detection_type detection_chance;

    detectUfoFromBase:
      - offset: 10 #Only spot anomaly sites when they are not moving.
        code: |

          var int temp;

          ufo.getStatus temp;
          if neq temp UFO_LANDED;
            ufo.Stats.getSpeedMax temp;
            if or eq temp 1000 eq temp 10000;
              set detection_chance 0;
            end;
          end;

          return detection_type detection_chance;

      - offset: 11 #Only spot ambush type encounters when they are locked on.
        code: |

          var int temp;

          ufo.getTag temp Tag.IS_AMBUSH;
          if gt temp 0;
            return 0 0;
          end;

          return detection_type detection_chance;

    accuracyMultiplierBonusStats:
      - offset: 10  #Aiming for the head reduces chance to hit.
        code: |

          var int temp;

          unit.getTag temp Tag.HEADSHOOTING_MODE;
          if or eq temp 0 lt battle_action 7 gt battle_action 9;
            return bonus;
          end;

          muldiv bonus 75 100;
          sub bonus 20;

          return bonus;

    costActionItem:
      - offset: 10 #Aiming for the head costs more TUs.
        code: |

          var int temp;

          unit.getTag temp Tag.HEADSHOOTING_MODE;
          if or eq temp 0 lt battle_action 7 gt battle_action 9;
            return;
          end;
          muldiv cost_time 130 100;

          return;

      - offset: 11 #SNOT lowers TU cost of actions.
        code: |

          var int temp;
          var int size;
          var int cost_reduction;
          var ptr BattleItem tempItem;
          var ptr RuleInventory belt_hopefully;
          var text slot_id;

          if or eq unit null eq cost_time 0;
            return;
          end;

          unit.getInventoryItem.size size;
          loop var q size;
            unit.getInventoryItem tempItem q;
            tempItem.getSlot belt_hopefully;
            belt_hopefully.getId slot_id;
            if eq slot_id "STR_BELT";
              tempItem.getTag temp Tag.ARTEFAKT_ID;
              #SNOT
              if eq temp 9;
                add cost_reduction 3;
              end;
            end;
          end;

          if eq cost_reduction 0;
            return;
          end;

          if eq flat_time 0;
            unit.Stats.getTimeUnits temp;
            muldiv cost_time temp 100;
            set flat_time 1;
          end;

          sub cost_time cost_reduction;
          if le cost_time 5;
            set cost_time 5;
          end;

          return;
