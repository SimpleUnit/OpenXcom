alienMissions:
  - type: pieseuGniazdoMisja
    objective: 1
    spawnZone: 5
    endlessInfiltration: false
    siteType: STR_DOG_NEST
    raceWeights:
      0:
        STR_BLINDDOG: 1
    waves:
      - ufo: STR_GROUP_LARGE_BLINDDOG
        count: 1
        trajectory: JUSTSPAWNBASE
        timer: 60
        objective: true

  - type: pieseuGniazdo
    objective: 2
    spawnZone: 2
    siteType: STR_DOG_NEST
    raceWeights:
      0:
        STR_BLINDDOG: 1
    waves:
      - ufo: STR_GROUP_LARGE_BLINDDOG
        count: 1
        trajectory: JUSTSPAWNBASE
        timer: 60
        objective: true

  - type: BEJSATAK
    objective: 4
    spawnUfo: STR_CAMPRAID_BLINDDOG
    raceWeights:
      0:
        STR_BLINDDOG: 1
    waves:
      - ufo: STR_GROUP_SMALL_BLINDDOG
        count: 5
        trajectory: DETECTMAINBASE
        timer: 360
    operationType: 1

  - type: mission01_radio_mission
    objective: 2
    spawnZone: 6
    endlessInfiltration: false
    siteType: STR_MISSION01_RADIO
    raceWeights:
      0:
        STR_ZOMBIFIED: 1
    waves:
      - ufo: STR_GROUP_SMALL_BANDIT
        count: 1
        trajectory: JUSTSPAWNBASE
